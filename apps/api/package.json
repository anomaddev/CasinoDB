{
  "name": "@casinodb/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "keys:create": "tsx src/scripts/create-api-client.ts",
    "docs:openapi": "tsx src/scripts/write-openapi.ts"
  },
  "dependencies": {
    "@casinodb/shared": "0.1.0",
    "@hono/node-server": "^1.14.1",
    "@hono/zod-validator": "^0.5.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.40.0",
    "hono": "^4.7.5",
    "postgres": "^3.4.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "yaml": "^2.7.0"
  }
}
