# PostgreSQL (docker compose default)
DATABASE_URL=postgres://casinodb:casinodb@localhost:5432/casinodb

# HMAC pepper for API key hashes and reporter hashes. Generate a long random string.
API_KEY_PEPPER=change-me-to-a-long-random-string

# Google Places API (New). Leave empty to run cache-only (DB reads, no Google refresh).
GOOGLE_PLACES_API_KEY=

# HTTP
PORT=3000
HOST=0.0.0.0

# Intel
# Table reports older than this are history, not "current"
CURRENT_TABLE_WINDOW_HOURS=24
# Incident counts on casino summaries
INCIDENT_SUMMARY_DAYS=90

# Places cache TTLs
PLACES_DETAILS_TTL_SECONDS=604800
PLACES_NEARBY_TTL_SECONDS=86400
PLACES_AUTOCOMPLETE_TTL_SECONDS=3600
